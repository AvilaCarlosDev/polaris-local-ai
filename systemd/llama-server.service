[Unit]
Description=llama.cpp server (router)
After=network.target

[Service]
Type=simple
ExecStart=/opt/llama.cpp/build/bin/llama-server -m /opt/ia/models/qwen2.5-vl-3b-instruct-q4_k_m.gguf --mmproj /opt/ia/models/mmproj-Qwen2.5-VL-3B-Instruct-Q8_0.gguf --host 0.0.0.0 --port 8080 -ngl 99 -c 65536 -ub 512 --parallel 1 --cache-type-k q8_0 --cache-type-v q8_0 --threads 4 --cache-reuse 4096 --api-key __IA_API_KEY__ --jinja
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
